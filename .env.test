# Variables de l'environnement de test (aucune valeur réelle).
# La connexion à la base de test se met dans .env.test.local (non versionné) :
#   DATABASE_URL="mysql://gc2:<mot_de_passe>@127.0.0.1:3306/guillaume_c2?serverVersion=mariadb-11.4.13&charset=utf8mb4"
# Doctrine ajoute automatiquement le suffixe _test au nom de la base (guillaume_c2_test).
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
ADMIN_PATH=admin
# Lot 6 : adresses fictives, appels HTTP simulés (tests/Support/MockHttpResponseFactory)
MAILER_REPLY_TO=reponse@example.test
DISCORD_WEBHOOK_URL=https://discord.example.test/api/webhooks/1/abc
# Application Discord de test : clé publique de la paire tirée de la graine « t » × 32 (tests/Support), aucun vrai jeton
DISCORD_APPLICATION_ID=111
DISCORD_PUBLIC_KEY=555f469c22188e90015bdd85b889678d459f86bdf8f7bd34971b10b9b3858609
DISCORD_BOT_TOKEN=jeton-de-test-du-bot
DISCORD_CHANNEL_ID=222
DISCORD_ADMIN_USER_ID=333
TELEGRAM_BOT_TOKEN=123:test
TELEGRAM_CHAT_ID=42
TELEGRAM_USER_ID=42
TELEGRAM_WEBHOOK_SECRET=secret-de-test-du-webhook
# IA : clé factice, API jamais appelée en test (client HTTP simulé)
MISTRAL_API_KEY=test-mistral-key-0000
MISTRAL_BASE_URL=https://mistral.example.test
MISTRAL_MODEL_PRIMARY=modele-principal-test
MISTRAL_MODEL_FALLBACK=modele-secours-test
