# Modèle des variables d'environnement du site guillaume-couget.fr (v2).
#
# Installation : copier ce fichier en .env (non versionné), puis mettre les vraies
# valeurs dans .env.local (non versionné). Aucune valeur secrète ici.
# En production : .env.local sur le serveur, ou coffre Symfony (bin/console secrets:set).

###> symfony/framework-bundle ###
APP_ENV=dev
# Générer avec : php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=
APP_SHARE_DIR=var/share
# Mandataires de confiance EN PLUS des plages Cloudflare (config/cloudflare_ip_ranges.php, toujours incluses) :
# adresse du cache de l’hébergeur s'il s'intercale, établie avec le diagnostic IP
SYMFONY_TRUSTED_PROXIES=
# 1 : page temporaire de diagnostic IP dans l'admin (/{ADMIN_PATH}/diagnostic-ip) ; à retirer après usage
IP_DIAGNOSTIC=0
###< symfony/framework-bundle ###

###> symfony/routing ###
# URL de base pour les liens absolus (e-mails, commandes console)
DEFAULT_URI=https://localhost:8000
###< symfony/routing ###

###> app ###
# Segment d'URL de l'admin (lettres minuscules, chiffres, tirets). Ex. : console-xxxxxxxxxxxx
# Après un changement : php bin/console cache:clear
ADMIN_PATH=admin
###< app ###

###> web-auth/webauthn-symfony-bundle ###
# Domaine de la clé YubiKey : localhost en développement, guillaume-couget.fr en production.
# Jamais d'adresse IP : WebAuthn refuse 127.0.0.1 (ouvrir le site sur https://localhost:8000).
RELYING_PARTY_ID=localhost
RELYING_PARTY_NAME="Guillaume Couget - administration"
# Origine autorisée (ses sous-domaines aussi) : https://guillaume-couget.fr en production
WEBAUTHN_ORIGIN=https://localhost:8000
###< web-auth/webauthn-symfony-bundle ###

###> doctrine/doctrine-bundle ###
# Exemple local (MariaDB 11.4, utilisateur dédié) : mysql://gc2:<mot_de_passe>@127.0.0.1:3306/guillaume_c2?serverVersion=mariadb-11.4.13&charset=utf8mb4
DATABASE_URL=
###< doctrine/doctrine-bundle ###

###> sauvegarde de la base (app:db:backup) ###
# Chemin de mysqldump s'il n'est pas dans le PATH, à mettre dans .env.local
# (Laragon : C:/laragon/bin/mysql/mariadb-11.4.13-winx64/bin/mysqldump.exe)
MYSQLDUMP_BINARY=mysqldump
###< sauvegarde de la base ###

###> lot 8 : référencement et migration de l'ancien site ###
# 1 : tout le site exclu des moteurs (environnement de test séparé) ; 0 en production
SITE_NOINDEX=0
# Copie de l'ancienne base (v1), lue en lecture seule par app:legacy:migrate ; à définir dans .env.local seulement
LEGACY_DATABASE_URL=
###< lot 8 ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/messenger ###
# Hébergement mutualisé : pas de worker permanent, transport synchrone
MESSENGER_TRANSPORT_DSN=sync://
###< symfony/messenger ###

###> espace recruteur et contact (lot 6) ###
# Expéditeur des e-mails (lien de connexion, rappels) : adresse du domaine, SPF/DKIM/DMARC dans le panneau de l’hébergeur
MAILER_FROM=noreply@example.test
MAILER_FROM_NAME="Guillaume Couget – Espace recruteur"
# Réponses des recruteurs : adresse réelle, à mettre dans .env.local (jamais dans le dépôt)
MAILER_REPLY_TO=
# Notifications (demandes d'accès, messages, signaux d'intérêt) : canaux vides = désactivés.
# E-mail : adresse de notification du compte admin (app:create-admin, Paramètres › Notifications).
DISCORD_WEBHOOK_URL=
# Application Discord (boutons interactifs, décision et code PIN dans Discord) : .env.local uniquement,
# jamais dans Git (check-staged-assets bloque toute valeur). Vides : webhook DISCORD_WEBHOOK_URL seul (repli).
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ADMIN_USER_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Validation à distance des demandes (boutons Telegram) : compte Telegram autorisé à appuyer (vide et
# conversation privée : celui de TELEGRAM_CHAT_ID ; obligatoire pour un groupe) et secret de l'en-tête du
# webhook en ligne (32 caractères ou plus : lettres, chiffres, _ et -), app:telegram:webhook set. En local,
# sans webhook : app:telegram:poll.
TELEGRAM_USER_ID=
TELEGRAM_WEBHOOK_SECRET=
# Cloudflare Turnstile : clés de test « toujours valide » par défaut ; vraies clés en production
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
###< espace recruteur et contact (lot 6) ###

###> IA (lot 7) : Mistral AI, offre gratuite (seul fournisseur) ###
# Clé dans .env.local seulement (jamais dans Git) ; modèles choisis après « php bin/console app:ai:check »
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai
MISTRAL_MODEL_PRIMARY=ministral-8b-2512
MISTRAL_MODEL_FALLBACK=ministral-3b-2512
###< IA ###

# Tableau de bord : surveillance des tâches planifiées (cron). Vide : seulement en production (« Non
# applicable en local » ailleurs) ; 1 : toujours ; 0 : jamais.
DASHBOARD_CRON_MONITORING=
