# Fichiers déposés par les visiteurs ou l'admin (le .htaccess reste versionné)
/public/uploads/*
!/public/uploads/.htaccess

# Fichiers sensibles : ne jamais versionner
*.sql
*.sql.gz
*.pem
*.key
*.p12
*.pfx
.env.local.bak.*
**/error_log

# Système et éditeurs
.DS_Store
Thumbs.db

# .htaccess propre au serveur, à la racine du projet (mot de passe d'un environnement de test)
/.htaccess

# public/images : uniquement des versions optimisées (WebP ou SVG, moins de 200 Ko).
# Les originaux sont rangés hors du dépôt, dans ../medias_originaux/ (voir scripts/images/optimize-image.php).
/public/images/**/*.png
/public/images/**/*.jpg
/public/images/**/*.jpeg
/public/images/**/*.gif

