{#
  Page : résultat d'une décision à distance (lien Discord), ou lien refusé (inconnu, expiré, déjà utilisé,
  bloqué, demande déjà traitée, validation à distance désactivée).
  Affichée par : RemoteDecisionController::show() et confirm().
  Variables attendues :
    - title   : clé de traduction du titre
    - text    : clé de traduction du texte
    - name    : nom du demandeur, ou null (lien inconnu)
    - success : vrai si la décision vient d'être appliquée
#}
{% extends 'base.html.twig' %}

{% block title %}{{ title|trans({'%name%': name ?? ''}) }} · {{ site_owner_name }}{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}

{% block body %}
    <div class="container mx-auto max-w-xl px-4 py-16 lg:py-24">
        <div class="card text-center" data-testid="remote-decision-result">
            <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">{{ title|trans({'%name%': name ?? ''}) }}</h1>
            <p class="mt-3 text-secondary-700 dark:text-secondary-300">{{ text|trans({'%name%': name ?? ''}) }}</p>
            {% if not success %}
                <p class="mt-6 text-sm text-secondary-600 dark:text-secondary-300">{{ 'remote_decision.use_admin'|trans }}</p>
            {% endif %}
        </div>
    </div>
{% endblock %}
