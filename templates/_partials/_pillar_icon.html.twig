{#
  Icône d'un pilier de compétences (cartes « Expertise » de l'accueil).
  Inclus par : home/index.html.twig.
  Variables attendues :
    - icon : climate, electric, design, digital, project ou generic (SkillPillar::ICONS)
  Dessins repris de la maquette ../maquette_accueil/index.html ; « project » (presse-papiers avec liste cochée,
  v2.0.1) dessiné dans le même style (trait de 1,8, extrémités arrondies).
#}
<svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    {% if icon == 'climate' %}
        <path stroke-linecap="round" d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9M9.5 4.5 12 6l2.5-1.5M9.5 19.5 12 18l2.5 1.5"/>
    {% elseif icon == 'electric' %}
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 3 5 14h6l-1 7 8-11h-6l1-7z"/>
    {% elseif icon == 'design' %}
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 20h16M6 16l9.5-9.5a2.1 2.1 0 0 1 3 3L9 19H6v-3z"/>
    {% elseif icon == 'digital' %}
        <rect x="3" y="4" width="18" height="12" rx="2"/><path stroke-linecap="round" d="M8 20h8M12 16v4M7 12l3-3 2 2 4-4"/>
    {% elseif icon == 'project' %}
        <rect x="5" y="4.5" width="14" height="16.5" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M9 3h6v3H9zM8.5 11l1.5 1.5 2.5-2.5M14.5 11.5H16M8.5 16l1.5 1.5 2.5-2.5M14.5 16.5H16"/>
    {% else %}
        <circle cx="12" cy="12" r="8"/><path stroke-linecap="round" d="M12 8v4l3 2"/>
    {% endif %}
</svg>
