{#
  Page d'erreur 404 (page introuvable) en production.
  Affichée par : le gestionnaire d'erreurs de Symfony (TwigBundle), uniquement si APP_DEBUG=0.
  Aucune variable spécifique.
#}
{% extends 'base.html.twig' %}

{% block title %}{{ 'error.not_found_title'|trans }} · {{ site_owner_name }}{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}

{% block body %}
    {{ include('bundles/TwigBundle/Exception/_error_content.html.twig', {
        code: 404,
        title: 'error.not_found_title'|trans,
        text: 'error.not_found_text'|trans,
    }) }}
{% endblock %}
