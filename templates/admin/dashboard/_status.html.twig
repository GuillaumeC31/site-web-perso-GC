{#
  Statut d'une tuile ou d'une ligne du tableau de bord : icône ET texte (jamais la couleur seule).
  Inclus par : admin/dashboard/_tile.html.twig, admin/dashboard/index.html.twig (récapitulatif),
  email/dashboard_summary.html.twig.
  Variables attendues :
    - status : ok, warning, problem ou not_applicable (DashboardMetrics::OK, WARNING, PROBLEM, NOT_APPLICABLE)
    - small  : vrai pour la version courte (ligne de détail : icône seule + texte masqué visuellement)
#}
{% set styles = {
    ok: {class: 'text-emerald-700 dark:text-emerald-300', path: 'M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z'},
    warning: {class: 'text-amber-800 dark:text-amber-300', path: 'M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z'},
    problem: {class: 'text-red-700 dark:text-red-300', path: 'M9.75 9.75l4.5 4.5m0-4.5-4.5 4.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z'},
    not_applicable: {class: 'text-secondary-600 dark:text-secondary-300', path: 'M15 12H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z'},
} %}
{% set style = styles[status] ?? styles.ok %}
<span class="inline-flex items-center gap-1 font-semibold {{ style.class }}" data-status="{{ status }}">
    <svg class="size-5 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="{{ style.path }}"/>
    </svg>
    <span class="{{ small|default(false) ? 'sr-only' : 'text-sm' }}">{{ ('admin.dashboard.status.' ~ status)|trans }}</span>
</span>
