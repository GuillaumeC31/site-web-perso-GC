{#
  Page : lien d'enrôlement refusé (invalide, expiré, déjà utilisé ou destiné à un autre compte).
  Affichée par : Admin\SecondFactorController::startEnrollment() (route admin_second_factor_enroll_start), code HTTP 403.
  Le motif précis n'est pas donné (il ne doit pas aider un attaquant).
  Aucune variable attendue.
#}
{% extends 'admin/base_minimal.html.twig' %}

{% block title %}{{ 'admin.second_factor.enrollment_invalid.title'|trans }}{% endblock %}

{% block body %}
    <twig:Alert type="danger">{{ 'admin.second_factor.enrollment_invalid.text'|trans }}</twig:Alert>
    <pre tabindex="0" class="overflow-x-auto rounded-lg bg-secondary-900 p-3 text-sm text-secondary-100"><code>php bin/console app:admin:reset-webauthn {{ app.user.userIdentifier }}</code></pre>
    <p class="text-sm"><a href="{{ path('admin_second_factor') }}" class="link">{{ 'admin.second_factor.back'|trans }}</a></p>
{% endblock %}
