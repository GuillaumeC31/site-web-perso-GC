{#
  Écran : questions des recruteurs restées sans réponse (information absente ou réponse bloquée), sans donnée
  du recruteur ; « Créer une fiche » (pré-remplie) ou « Ignorer ».
  Affiché par : Admin\AiKnowledgeController::unanswered() (route admin_ai_knowledge_unanswered).
  Variables attendues :
    - questions : list<UnansweredQuestion> à traiter
#}
{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.ai_knowledge.unanswered_title'|trans }}{% endblock %}

{% block body %}
    <nav class="mb-4 text-sm"><a href="{{ path('admin_ai_knowledge_index') }}" class="link">← {{ 'admin.ai_knowledge.title'|trans }}</a></nav>
    <h1 class="mb-2 text-2xl font-bold dark:text-white">{{ 'admin.ai_knowledge.unanswered_title'|trans }}</h1>
    <p class="form-help mb-6">{{ 'admin.ai_knowledge.unanswered_intro'|trans }}</p>

    {% if questions is empty %}
        <twig:Card><p class="text-secondary-600 dark:text-secondary-300">{{ 'admin.ai_knowledge.unanswered_none'|trans }}</p></twig:Card>
    {% else %}
        <ul class="space-y-3" data-testid="unanswered-list">
            {% for question in questions %}
                <li class="rounded-2xl border border-secondary-200 bg-white p-4 dark:border-secondary-700 dark:bg-secondary-800">
                    <p class="text-sm text-secondary-600 dark:text-secondary-400">
                        {{ question.createdAt|format_datetime('short', 'short') }} ·
                        {{ ('admin.ai_knowledge.reason.' ~ question.reason)|trans({'%element%': question.blockedElement}) }}
                    </p>
                    <p class="mt-1 whitespace-pre-line">{{ question.question }}</p>
                    <div class="mt-3 flex flex-wrap gap-2">
                        <twig:Button href="{{ path('admin_ai_knowledge_new', {question: question.id}) }}" size="sm">{{ 'admin.ai_knowledge.create_from_question'|trans }}</twig:Button>
                        <form method="post" action="{{ path('admin_ai_knowledge_unanswered_ignore', {id: question.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('unanswered_ignore_' ~ question.id) }}">
                            <twig:Button type="submit" variant="secondary" size="sm">{{ 'admin.ai_knowledge.ignore'|trans }}</twig:Button>
                        </form>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
