{#
  Écran : historique d'une fiche du « Cerveau de l'IA » (quand, ancien contenu).
  Affiché par : Admin\AiKnowledgeController::history() (route admin_ai_knowledge_history).
  Variables attendues :
    - entry     : AiKnowledgeEntry (version actuelle)
    - revisions : list<AiKnowledgeRevision>, de la plus récente à la plus ancienne
#}
{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.ai_knowledge.history_title'|trans({'%title%': entry.title}) }}{% endblock %}

{% block body %}
    <nav class="mb-4 text-sm"><a href="{{ path('admin_ai_knowledge_index') }}" class="link">← {{ 'admin.ai_knowledge.title'|trans }}</a></nav>
    <h1 class="mb-6 text-2xl font-bold dark:text-white">{{ 'admin.ai_knowledge.history_title'|trans({'%title%': entry.title}) }}</h1>

    <twig:Card title="{{ 'admin.ai_knowledge.history_current'|trans({'%date%': entry.updatedAt|format_datetime('short', 'short')}) }}" class="mb-6">
        <p class="text-sm font-semibold">{{ entry.category.translationKey|trans }} · {{ (entry.active ? 'admin.ai_knowledge.active' : 'admin.ai_knowledge.draft')|trans }}</p>
        <p class="mt-2 whitespace-pre-line">{{ entry.content }}</p>
    </twig:Card>

    {% if revisions is empty %}
        <p class="text-secondary-600 dark:text-secondary-400">{{ 'admin.ai_knowledge.history_empty'|trans }}</p>
    {% else %}
        <ol class="space-y-4" data-testid="ai-history">
            {% for revision in revisions %}
                <li class="rounded-2xl border border-secondary-200 bg-white p-4 dark:border-secondary-700 dark:bg-secondary-800">
                    <p class="text-sm text-secondary-600 dark:text-secondary-400">{{ 'admin.ai_knowledge.history_before'|trans({'%date%': revision.changedAt|format_datetime('short', 'short')}) }}</p>
                    <p class="mt-1 font-semibold">{{ revision.title }} <span class="font-normal text-secondary-600 dark:text-secondary-400">· {{ revision.category.translationKey|trans }} · {{ (revision.active ? 'admin.ai_knowledge.active' : 'admin.ai_knowledge.draft')|trans }}</span></p>
                    <p class="mt-2 text-sm whitespace-pre-line">{{ revision.content }}</p>
                </li>
            {% endfor %}
        </ol>
    {% endif %}
{% endblock %}
