{% set current_route = app.current_route %}
<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex, nofollow">
        <meta name="color-scheme" content="light dark">
        <title>{% block title %}{{ 'admin.meta_title'|trans }}{% endblock %} · {{ site_owner_name }}</title>
        <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="48x48">
        <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
        {# Nonce CSP lu par Turbo et assets/lib/csp_nonce.js (navigations Turbo) #}
        <meta name="csp-nonce" content="{{ csp_nonce() }}">
        {{ include('_partials/_theme_script.html.twig') }}
        {{ vite_entry_link_tags('app') }}
        {{ vite_entry_script_tags('app') }}
    </head>
    <body>
        <div class="mx-auto flex min-h-dvh w-full min-w-80 flex-col bg-secondary-100 lg:pl-64 dark:bg-secondary-900 dark:text-secondary-100"
             data-controller="disclosure"
             data-disclosure-open-class="translate-x-0"
             data-disclosure-closed-class="-translate-x-full">

            {# Barre latérale #}
            <nav id="admin-sidebar"
                 class="fixed top-0 bottom-0 left-0 z-50 flex h-full w-full -translate-x-full flex-col border-r border-secondary-200 bg-white transition-transform duration-300 ease-out lg:w-64 lg:translate-x-0 dark:border-secondary-800 dark:bg-secondary-800 dark:text-secondary-200"
                 data-disclosure-target="panel"
                 aria-label="{{ 'admin.sidebar_navigation'|trans }}">
                <div class="flex h-16 w-full flex-none items-center justify-between px-4 lg:justify-center dark:bg-secondary-600/25">
                    <a href="{{ path('admin_dashboard') }}" class="group inline-flex items-center gap-2 text-lg font-bold tracking-wide text-secondary-900 hover:text-secondary-600 dark:text-secondary-100 dark:hover:text-secondary-300">
                        <span class="inline-flex size-7 items-center justify-center rounded-lg bg-primary-700 text-xs font-black text-white" aria-hidden="true">GC</span>
                        <span>{{ 'admin.brand'|trans }}</span>
                    </a>
                    <div class="lg:hidden">
                        <button type="button" class="btn btn-secondary btn-sm" data-action="disclosure#close" aria-controls="admin-sidebar">
                            <span class="sr-only">{{ 'admin.close_sidebar'|trans }}</span>
                            <svg class="-mx-0.5 size-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <div class="overflow-y-auto">
                    <div class="w-full space-y-1 p-4">
                        {% for group in admin_nav %}
                        {% if group.section %}
                            <div class="px-3 pt-5 pb-2 text-xs font-semibold tracking-wider text-secondary-500 uppercase dark:text-secondary-400">{{ group.section|trans }}</div>
                        {% endif %}
                        {% for item in group.items %}
                            {% set is_current = current_route starts with item.prefix and not (item.exclude is defined and current_route starts with item.exclude) %}
                            <a href="{{ path(item.route) }}"
                               class="group flex items-center gap-2 rounded-lg border px-2.5 text-sm font-medium {{ is_current ? 'border-primary-100 bg-primary-50 text-secondary-900 dark:border-transparent dark:bg-secondary-700/75 dark:text-white' : 'border-transparent text-secondary-800 hover:bg-primary-50 hover:text-secondary-900 dark:text-secondary-200 dark:hover:bg-secondary-700/75 dark:hover:text-white' }}"
                               {% if is_current %}aria-current="page"{% endif %}>
                                <span class="flex flex-none items-center {{ is_current ? 'text-primary-600 dark:text-secondary-300' : 'text-secondary-400 group-hover:text-primary-600 dark:text-secondary-500' }}">
                                    <svg class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="{{ item.icon }}"/>
                                    </svg>
                                </span>
                                <span class="grow py-2">{{ item.label|trans }}</span>
                                {# Pastille « Messages » : messages non lus de la boîte (hors archivés) #}
                                {% if item.route == 'admin_contact_message_index' and is_granted('ADMIN_KEY_VERIFIED') %}
                                    {% set unread = admin_unread_messages() %}
                                    {% if unread > 0 %}
                                        <span class="rounded-full bg-red-700 px-2 py-0.5 text-xs font-bold text-white tabular-nums" data-testid="admin-unread-badge">{{ unread }}<span class="sr-only"> {{ 'admin.contact_message.unread_badge'|trans({'%count%': unread}) }}</span></span>
                                    {% endif %}
                                {% endif %}
                                {% if item.route == 'admin_dashboard' and is_granted('ADMIN_KEY_VERIFIED') %}
                                    {% set attention = admin_attention_count() %}
                                    {% if attention > 0 %}
                                        <span class="rounded-full bg-red-700 px-2 py-0.5 text-xs font-bold text-white tabular-nums" data-testid="admin-attention-badge">{{ attention }}<span class="sr-only"> {{ 'admin.dashboard.attention'|trans({'%count%': attention}) }}</span></span>
                                    {% endif %}
                                {% endif %}
                            </a>
                        {% endfor %}
                        {% endfor %}
                    </div>
                </div>
            </nav>

            {# En-tête #}
            <header class="fixed top-0 right-0 left-0 z-30 flex h-16 flex-none items-center bg-white shadow-xs lg:pl-64 dark:bg-secondary-800">
                <div class="mx-auto flex w-full max-w-10xl items-center justify-between px-4 lg:px-8">
                    <div class="lg:hidden">
                        <button type="button" class="btn btn-secondary btn-sm" data-action="disclosure#toggle" data-disclosure-target="button" aria-expanded="false" aria-controls="admin-sidebar">
                            <span class="sr-only">{{ 'admin.open_sidebar'|trans }}</span>
                            <svg class="size-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h6a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
                            </svg>
                        </button>
                    </div>
                    <div class="hidden text-sm font-semibold text-secondary-600 lg:block dark:text-secondary-300">{{ site_owner_name }}</div>
                    <div class="flex items-center gap-2">
                        {# Moins de 640 px : icône seule (texte lu par les lecteurs d'écran), sinon les trois boutons ne tiennent pas à 375 px #}
                        <a href="{{ path('home') }}" class="btn btn-secondary btn-sm" data-turbo="false">
                            <svg class="size-5 sm:hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M9.293 2.293a1 1 0 0 1 1.414 0l7 7A1 1 0 0 1 17 11h-1v6a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1v-3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-6H3a1 1 0 0 1-.707-1.707l7-7Z" clip-rule="evenodd"/></svg>
                            <span class="max-sm:sr-only">{{ 'admin.view_site'|trans }}</span>
                        </a>
                        {{ include('_partials/_theme_toggle.html.twig') }}
                        <a href="{{ path('admin_logout') }}" class="btn btn-secondary btn-sm" data-turbo="false">{{ 'admin.logout'|trans }}</a>
                    </div>
                </div>
            </header>

            {# Contenu #}
            <main id="main-content" class="flex max-w-full min-w-0 flex-auto flex-col pt-16">
                <div class="mx-auto w-full max-w-10xl p-4 lg:p-8">
                    {{ include('_partials/_flash_messages.html.twig') }}
                    {% block body %}{% endblock %}
                </div>
                {# Version (fichier VERSION, service AppVersion) : affichée dans l'admin seulement ; lien vers le journal des versions #}
                {% set version = app_version() %}
                {% if version %}
                    <footer class="mx-auto mt-auto w-full max-w-10xl px-4 pb-6 text-xs text-secondary-600 lg:px-8 dark:text-secondary-400">
                        <a href="{{ path('admin_changelog') }}" class="hover:underline" title="{{ 'admin.changelog.title'|trans }}">{{ 'admin.dashboard.version'|trans({'%version%': version}) }}</a>
                    </footer>
                {% endif %}
            </main>
        </div>
    </body>
</html>
