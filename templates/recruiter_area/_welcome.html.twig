{#
  Bienvenue du recruteur, à sa première connexion après la validation (une seule fois) : contenu de
  l'espace, durée de l'accès, lien « Mes données ». Avec JavaScript, le panneau s'ouvre en fenêtre
  (contrôleur « notify », mode fenêtre d'information) ; sans JavaScript, il reste en haut de la page.
  Inclus par : recruiter_area/home.html.twig (flash « recruiter_welcome » de RecruiterLoginSubscriber).
  Variables attendues :
    - recruiter : Recruiter connecté
#}
<section class="mb-8 rounded-2xl border border-primary-200 bg-primary-50 p-6 text-secondary-800 dark:border-primary-800 dark:bg-primary-950/40 dark:text-secondary-100"
         aria-labelledby="welcome-title" data-testid="recruiter-welcome"
         data-controller="notify" data-notify-dialog-value="true"
         data-notify-title-value="{{ 'recruiter_area.home.first_visit.title'|trans }}"
         data-notify-confirm-label-value="{{ 'recruiter_area.home.first_visit.close'|trans }}">
    <h2 id="welcome-title" class="text-lg font-bold text-secondary-900 dark:text-white" data-notify-skip>{{ 'recruiter_area.home.first_visit.title'|trans }}</h2>
    <p class="mt-2">{{ 'recruiter_area.home.first_visit.intro'|trans }}</p>
    <ul class="mt-2 list-disc space-y-1 pl-5 text-left">
        <li>{{ 'recruiter_area.home.first_visit.contact'|trans }}</li>
        <li>{{ 'recruiter_area.home.first_visit.cv'|trans }}</li>
        <li>{{ 'recruiter_area.home.first_visit.career'|trans }}</li>
        <li>{{ 'recruiter_area.home.first_visit.projects'|trans }}</li>
        <li>{{ 'recruiter_area.home.first_visit.assistant'|trans }}</li>
    </ul>
    <p class="mt-3 font-semibold">{{ 'recruiter_area.home.first_visit.access'|trans({'%date%': recruiter.accessExpiresAt|format_date('long')}) }}</p>
    <p class="mt-3">{{ 'recruiter_area.home.first_visit.data_text'|trans }} <a href="{{ path('recruiter_data') }}" class="link">{{ 'recruiter_area.home.first_visit.data'|trans }}</a></p>
</section>
