{#
  Page : confirmation du lien de connexion. Le lien de l'e-mail ouvre cette page (GET) ; le bouton
  envoie le lien en POST au pare-feu « recruiter » (check_post_only), pour que les scanners de liens
  des messageries ne consomment pas le lien à usage unique.
  Affichée par : RecruiterAreaController::loginCheck() (route recruiter_login_check).
  Variables attendues :
    - query : paramètres signés du lien (user, expires, hash), renvoyés tels quels
#}
{% extends 'base.html.twig' %}

{% block title %}{{ 'recruiter_area.login_check.title'|trans }} · {{ site_owner_name }}{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}

{% block body %}
    <div class="container mx-auto max-w-xl px-4 py-16 lg:py-24">
        <div class="card text-center">
            <h1 class="text-2xl font-bold text-secondary-900 dark:text-white">{{ 'recruiter_area.login_check.title'|trans }}</h1>
            <p class="mt-3 text-secondary-700 dark:text-secondary-300">{{ 'recruiter_area.login_check.text'|trans }}</p>
            <form method="post" action="{{ path('recruiter_login_check', query) }}" class="mt-6" data-turbo="false">
                <twig:Button type="submit">{{ 'recruiter_area.login_check.submit'|trans }}</twig:Button>
            </form>
            <p class="mt-6 text-sm text-secondary-600 dark:text-secondary-300">{{ 'recruiter_area.login_check.notice'|trans }}</p>
        </div>
    </div>
{% endblock %}
