{#
  Carte d'un projet (liste des projets, études de cas de l'accueil).
  Inclus par : project/index.html.twig, home/index.html.twig.
  Variables attendues :
    - project : Project visible (Project::isPubliclyVisible())
    - heading_level : niveau du titre de la carte (h2 ou h3 ; défaut h3)
  Toute la carte est cliquable (lien étiré sur le titre), sans lien imbriqué.
  Couverture en WebP avec srcset (600 et 1200 px) et chargement différé ; sans couverture,
  un dégradé de la couleur du site avec une icône (maquette ../maquette_accueil/).
#}
{% set heading_level = heading_level ?? 'h3' %}
{% set first_category = project.categories|first %}
<article class="card group relative flex flex-col overflow-hidden p-0 transition hover:-translate-y-0.5 hover:shadow-lg motion-reduce:transition-none motion-reduce:hover:translate-y-0">
    {% if project.coverImage %}
        <img src="{{ project_image(project.coverImage, true) }}"
             srcset="{{ project_image_srcset(project.coverImage, 1200) }}"
             sizes="(min-width: 768px) 33vw, 100vw"
             alt="{{ project.coverAlt ?? '' }}" width="1200" height="675" loading="lazy" decoding="async"
             class="aspect-[16/9] w-full object-cover">
    {% elseif project.type.value == 'lab' %}
        <div class="flex aspect-[16/9] items-center justify-center bg-gradient-to-br from-secondary-700 to-secondary-900 text-secondary-100" aria-hidden="true">
            <svg class="size-14 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5"/></svg>
        </div>
    {% else %}
        <div class="flex aspect-[16/9] items-center justify-center bg-gradient-to-br from-primary-700 to-primary-900 text-primary-100" aria-hidden="true">
            <svg class="size-14 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.4"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6"/></svg>
        </div>
    {% endif %}
    <div class="flex flex-1 flex-col p-6">
        <div class="flex flex-wrap gap-2">
            {% if first_category %}
                <span class="rounded-full bg-primary-50 px-2.5 py-0.5 text-xs font-semibold text-primary-700 dark:bg-primary-500/10 dark:text-primary-300">{{ first_category.name }}</span>
            {% endif %}
        </div>
        <{{ heading_level }} class="mt-3 font-bold text-secondary-900 dark:text-white">
            <a href="{{ path('project_show', {slug: project.slug}) }}" class="after:absolute after:inset-0 focus:outline-none focus-visible:underline">{{ project.title }}</a>
        </{{ heading_level }}>
        {% if project.clientLabel %}
            <p class="mt-1 text-sm font-medium text-secondary-500 dark:text-secondary-400">{{ project.clientLabel }}</p>
        {% endif %}
        <p class="mt-2 text-sm/relaxed text-secondary-600 dark:text-secondary-300">{{ project.summary }}</p>
        <p class="mt-auto pt-4 text-sm font-semibold text-primary-700 group-hover:text-primary-800 dark:text-primary-300" aria-hidden="true">{{ 'project.read_more'|trans }} →</p>
    </div>
</article>
