{#
  Page : détail d'un projet (CDC §6).
  Affichée par : ProjectController::show() (route project_show, /projets/{slug}) et
  Admin\ProjectController::preview() (aperçu avant publication, même brouillon).
  Variables attendues :
    - project    : Project
    - is_preview : vrai dans l'aperçu de l'admin (bandeau, page non indexée)
    - recruiter_view (facultatif) : vrai dans l'espace recruteur (RecruiterAreaController::project(),
      route recruiter_project) : page non indexée, retour à l'espace recruteur
  Étude de cas : plan imposé (contexte, problème, solution, résultat, compétences mobilisées).
  Le contenu Markdown passe par le filtre project_markdown (HTML nettoyé côté serveur).
  La galerie n'affiche que les images qui ne sont pas déjà insérées dans le contenu.
#}
{% extends 'base.html.twig' %}

{% block title %}{{ project.title }} · {{ 'project.title'|trans }} · {{ site_owner_name }}{% endblock %}
{% block description %}{{ (project.summary ?? '')|length > 160 ? project.summary|slice(0, 159) ~ '…' : project.summary }}{% endblock %}
{% block robots %}{{ is_preview or recruiter_view|default(false) ? 'noindex, nofollow' : 'index, follow' }}{% endblock %}

{% set is_case_study = project.type.value == 'case_study' %}
{% set gallery = project.images|filter(image => image.filename not in (project.content ?? '')) %}

{% block body %}
    {% if is_preview %}
        <div class="border-b border-amber-200 bg-amber-50 text-amber-900 dark:border-amber-800 dark:bg-amber-950/60 dark:text-amber-100">
            <div class="container mx-auto flex flex-wrap items-center justify-between gap-3 px-4 py-3 text-sm lg:px-8 xl:max-w-5xl">
                <p>
                    <strong>{{ 'project.preview.banner'|trans }}</strong>
                    {% if not project.publiclyVisible %} — {{ 'project.preview.not_visible'|trans }}{% endif %}
                </p>
                <a href="{{ path('admin_project_edit', {id: project.id}) }}" class="font-semibold underline">{{ 'project.preview.back'|trans }}</a>
            </div>
        </div>
    {% endif %}

    <article class="container mx-auto px-4 py-12 lg:px-8 lg:py-16 xl:max-w-5xl">
        <nav aria-label="{{ 'project.breadcrumb'|trans }}" class="text-sm">
            <ol class="flex flex-wrap items-center gap-2 text-secondary-600 dark:text-secondary-300">
                {% if recruiter_view|default(false) %}
                    <li><a href="{{ path('recruiter_home') }}" class="font-medium text-primary-700 hover:text-primary-800 dark:text-primary-300">{{ 'recruiter_area.home.title'|trans }}</a></li>
                {% else %}
                    <li><a href="{{ path('project_list') }}" class="font-medium text-primary-700 hover:text-primary-800 dark:text-primary-300">{{ 'project.title'|trans }}</a></li>
                    <li aria-hidden="true">/</li>
                    <li><a href="{{ path('project_list', {type: project.type.urlValue}) }}" class="font-medium text-primary-700 hover:text-primary-800 dark:text-primary-300">{{ project.type.translationKey|trans }}</a></li>
                {% endif %}
            </ol>
        </nav>

        <header class="mt-6">
            {% if project.categories is not empty %}
                <ul class="flex flex-wrap gap-2" aria-label="{{ 'project.categories_label'|trans }}">
                    {% for category in project.categories %}
                        <li><span class="rounded-full bg-primary-50 px-2.5 py-0.5 text-xs font-semibold text-primary-700 dark:bg-primary-500/10 dark:text-primary-300">{{ category.name }}</span></li>
                    {% endfor %}
                </ul>
            {% endif %}
            <h1 class="mt-4 text-3xl font-black tracking-tight text-secondary-900 sm:text-4xl dark:text-white">{{ project.title }}</h1>
            {% if project.clientLabel or project.projectDate %}
                <p class="mt-2 font-medium text-secondary-600 dark:text-secondary-300">
                    {{ project.clientLabel }}{% if project.clientLabel and project.projectDate %} · {% endif %}
                    {%- if project.projectDate %}<time datetime="{{ project.projectDate|date('Y-m') }}">{{ project.projectDate|format_date(pattern: 'MMMM y')|capitalize }}</time>{% endif %}
                </p>
            {% endif %}
            {% if project.summary %}
                <p class="text-prose-justify mt-5 text-lg/relaxed text-secondary-700 dark:text-secondary-300">{{ project.summary|hyphenate }}</p>
            {% endif %}
        </header>

        {% if project.coverImage %}
            <img src="{{ project_image(project.coverImage) }}"
                 srcset="{{ project_image_srcset(project.coverImage, 1200) }}"
                 sizes="(min-width: 1024px) 64rem, 100vw"
                 alt="{{ project.coverAlt ?? '' }}" width="1200" height="675" loading="eager" fetchpriority="high"
                 class="mt-8 aspect-[16/9] w-full rounded-2xl object-cover shadow-sm ring-1 ring-secondary-900/10">
        {% endif %}

        {# Étude de cas : plan imposé #}
        {% if is_case_study %}
            <div class="mt-10 grid gap-6 md:grid-cols-2">
                {% for field in ['context', 'problem', 'solution'] %}
                    {% set text = attribute(project, field) %}
                    {% if text %}
                        <section class="card">
                            <h2 class="text-sm font-semibold tracking-wider text-primary-700 uppercase dark:text-primary-300">{{ ('project.section.' ~ field)|trans }}</h2>
                            <div class="text-prose-justify mt-3 space-y-3 text-secondary-700 dark:text-secondary-300">
                                {% for paragraph in text|split("\n\n") %}<p>{{ paragraph|hyphenate|nl2br }}</p>{% endfor %}
                            </div>
                        </section>
                    {% endif %}
                {% endfor %}
                {% if project.result %}
                    <section class="card border-primary-200 bg-primary-50/60 dark:border-primary-800 dark:bg-primary-950/40">
                        <h2 class="text-sm font-semibold tracking-wider text-primary-700 uppercase dark:text-primary-300">{{ 'project.section.result'|trans }}</h2>
                        <div class="text-prose-justify mt-3 space-y-3 font-medium text-secondary-900 dark:text-white">
                            {% for paragraph in project.result|split("\n\n") %}<p>{{ paragraph|hyphenate|nl2br }}</p>{% endfor %}
                        </div>
                    </section>
                {% endif %}
            </div>
            {% if project.competenceList is not empty %}
                <section class="mt-8">
                    <h2 class="text-sm font-semibold tracking-wider text-primary-700 uppercase dark:text-primary-300">{{ 'project.section.competences'|trans }}</h2>
                    <ul class="mt-3 flex flex-wrap gap-2">
                        {% for competence in project.competenceList %}
                            <li><twig:Badge tone="neutral">{{ competence }}</twig:Badge></li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}
        {% endif %}

        {# Contenu riche #}
        {% if project.content|trim is not empty %}
            <div class="prose prose-lg prose-slate text-prose-justify mt-10 max-w-none dark:prose-invert prose-a:text-primary-700 dark:prose-a:text-primary-300 prose-img:rounded-xl">
                {# HTML nettoyé côté serveur (MarkdownRenderer) : le filtre est marqué sûr #}
                {{ project.content|project_markdown|hyphenate_html }}
            </div>
        {% endif %}

        {# Technologies et liens #}
        {% if project.technologyList is not empty or project.repositoryUrl or project.demoUrl %}
            <section class="mt-10 border-t border-secondary-200 pt-8 dark:border-secondary-700">
                {% if project.technologyList is not empty %}
                    <h2 class="text-sm font-semibold tracking-wider text-primary-700 uppercase dark:text-primary-300">{{ 'project.technologies'|trans }}</h2>
                    <ul class="mt-3 flex flex-wrap gap-2">
                        {% for technology in project.technologyList %}
                            <li><twig:Badge>{{ technology }}</twig:Badge></li>
                        {% endfor %}
                    </ul>
                {% endif %}
                {% if project.repositoryUrl or project.demoUrl %}
                    <div class="mt-6 flex flex-wrap gap-3">
                        {% if project.demoUrl %}<twig:Button href="{{ project.demoUrl }}" rel="noopener noreferrer" target="_blank">{{ 'project.demo'|trans }}</twig:Button>{% endif %}
                        {% if project.repositoryUrl %}<twig:Button href="{{ project.repositoryUrl }}" variant="secondary" rel="noopener noreferrer" target="_blank">{{ 'project.repository'|trans }}</twig:Button>{% endif %}
                    </div>
                {% endif %}
            </section>
        {% endif %}

        {# Galerie (images non insérées dans le contenu) #}
        {% if gallery is not empty %}
            <section class="mt-10" aria-labelledby="gallery-title">
                <h2 id="gallery-title" class="text-sm font-semibold tracking-wider text-primary-700 uppercase dark:text-primary-300">{{ 'project.gallery'|trans }}</h2>
                <ul class="mt-4 grid gap-4 sm:grid-cols-2">
                    {% for image in gallery %}
                        <li>
                            <a href="{{ project_image(image.filename) }}" class="block overflow-hidden rounded-xl ring-1 ring-secondary-900/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600" data-turbo="false">
                                <img src="{{ project_image(image.filename, image.width > 600) }}"
                                     srcset="{{ project_image_srcset(image.filename, image.width) }}"
                                     sizes="(min-width: 640px) 50vw, 100vw"
                                     alt="{{ image.alt ?? '' }}" width="{{ image.width }}" height="{{ image.height }}" loading="lazy" decoding="async"
                                     class="h-full w-full object-cover transition hover:scale-[1.02] motion-reduce:transition-none">
                            </a>
                            {% if image.alt %}<p class="mt-2 text-sm text-secondary-600 dark:text-secondary-300">{{ image.alt }}</p>{% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        <div class="mt-12 flex flex-wrap gap-3">
            {% if recruiter_view|default(false) %}
                <twig:Button href="{{ path('recruiter_home') }}" variant="secondary">← {{ 'recruiter_area.home.back'|trans }}</twig:Button>
            {% else %}
                <twig:Button href="{{ path('project_list') }}" variant="secondary">← {{ 'project.back'|trans }}</twig:Button>
            {% endif %}
            <twig:Button href="{{ path('contact_show') }}">{{ 'home.cta_contact'|trans }}</twig:Button>
        </div>
    </article>
{% endblock %}
