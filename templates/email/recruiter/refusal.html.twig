{#
  E-mail : demande d'accès non retenue (sans motif, aucune adresse de réponse ; décision du 2026-10-29).
  Envoyé par : RecruiterMailer::sendRefusal(). Variables : recruiter, texts (EmailTexts : intro, signature), subject,
  contact_url (pied : formulaire de contact du site).
#}
{% extends 'email/_layout.html.twig' %}

{% block content %}
    <p style="margin:0 0 12px;">Bonjour {{ recruiter.fullName }},</p>
    <p style="margin:0 0 12px;">{{ texts.intro|nl2br }}</p>
    <p style="margin:0 0 12px;">Les informations de votre demande seront supprimées 30 jours après cette décision.</p>
    <p style="margin:0;">{{ texts.signature|nl2br }}</p>
{% endblock %}
