{#
  Mise en page commune des e-mails HTML : une colonne, styles en ligne, aucune image ni pièce jointe
  (délivrabilité). Étendu par : templates/email/**/*.html.twig
  Blocs : content (corps), button (lien principal facultatif), footer.
  Variables : subject (titre) ; posées par MailFactory::createTyped() : can_reply (adresse de réponse présente :
  recruteur validé), contact_url (demande non validée : aucune adresse de réponse, formulaire de contact du site).
#}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f1f5f9;font-family:Arial,Helvetica,sans-serif;color:#1e293b;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f1f5f9;padding:24px 12px;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:12px;padding:28px;">
                    <tr><td style="font-size:14px;font-weight:bold;color:#00786f;padding-bottom:16px;">Guillaume Couget · guillaume-couget.fr</td></tr>
                    <tr><td style="font-size:15px;line-height:1.6;">{% block content %}{% endblock %}</td></tr>
                    {% block button %}{% endblock %}
                    <tr><td style="font-size:12px;line-height:1.5;color:#64748b;padding-top:24px;border-top:1px solid #e2e8f0;">
                        {% block footer %}
                            {%- if contact_url ?? null -%}
                                Message envoyé automatiquement par guillaume-couget.fr : merci de ne pas y répondre. Pour écrire à Guillaume, utilisez le formulaire de contact du site : <a href="{{ contact_url }}" style="color:#00786f;">{{ contact_url }}</a>
                            {%- elseif can_reply ?? false -%}
                                Message envoyé automatiquement par guillaume-couget.fr. Vous pouvez répondre à cet e-mail.
                            {%- else -%}
                                Message envoyé automatiquement par guillaume-couget.fr.
                            {%- endif -%}
                        {% endblock %}
                    </td></tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
