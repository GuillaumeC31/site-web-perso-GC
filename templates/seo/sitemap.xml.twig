{#-
  Plan du site (sitemap.xml).
  Rendu par : SitemapController::sitemap() (route sitemap, /sitemap.xml).
  Variables attendues :
    - urls : adresses absolues des pages publiques
-#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for url in urls %}
    <url><loc>{{ url }}</loc></url>
{% endfor %}
</urlset>
