{#
  Bloc : une section repliable de la politique de confidentialité (élément details natif : fonctionne sans JavaScript,
  accessible au clavier ; le texte reste trouvable par la recherche du navigateur, qui ouvre la section).
  Inclus par : legal/privacy.html.twig (via embed).
  Variables attendues :
    - id    : identifiant de la section (ancre)
    - title : titre déjà traduit (niveau 2)
  Bloc : content (paragraphes, tableaux), justifié avec la césure française (filtre hyphenate_html)
#}
<details id="{{ id }}" class="group scroll-mt-24 rounded-2xl border border-secondary-200 bg-white dark:border-secondary-700 dark:bg-secondary-900">
    <summary class="flex cursor-pointer list-none items-center justify-between gap-3 rounded-2xl px-5 py-4 hover:bg-secondary-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700 dark:hover:bg-secondary-800/60 [&::-webkit-details-marker]:hidden">
        <h2 id="{{ id }}-title" class="text-lg font-bold text-secondary-900 dark:text-white">{{ title }}</h2>
        <svg class="size-5 shrink-0 text-secondary-500 transition-transform group-open:rotate-180 dark:text-secondary-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 011.06 0L10 11.94l3.72-3.72a.75.75 0 111.06 1.06l-4.25 4.25a.75.75 0 01-1.06 0L5.22 9.28a.75.75 0 010-1.06z" clip-rule="evenodd"/></svg>
    </summary>
    <div class="text-prose-justify space-y-3 border-t border-secondary-200 px-5 py-4 dark:border-secondary-700">
        {% apply hyphenate_html %}{% block content %}{% endblock %}{% endapply %}
    </div>
</details>
