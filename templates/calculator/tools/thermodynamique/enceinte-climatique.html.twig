{% set iconRegulation = 'M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93.398.164.855.142 1.205-.108l.737-.527a1.125 1.125 0 011.45.12l.773.774c.39.389.44 1.002.12 1.45l-.527.737c-.25.35-.272.806-.107 1.204.165.397.505.71.93.78l.893.15c.543.09.94.56.94 1.109v1.094c0 .55-.397 1.02-.94 1.11l-.893.149c-.425.07-.765.383-.93.78-.165.398-.143.854.107 1.204l.527.738c.32.447.269 1.06-.12 1.45l-.774.773a1.125 1.125 0 01-1.449.12l-.738-.527c-.35-.25-.806-.272-1.203-.107-.397.165-.71.505-.781.929l-.149.894c-.09.542-.56.94-1.11.94h-1.094c-.55 0-1.019-.398-1.11-.94l-.148-.894c-.071-.424-.384-.764-.781-.93-.398-.164-.854-.142-1.204.108l-.738.527c-.447.32-1.06.269-1.45-.12l-.773-.774a1.125 1.125 0 01-.12-1.45l.527-.737c.25-.35.273-.806.108-1.204-.165-.397-.505-.71-.93-.78l-.894-.15c-.542-.09-.94-.56-.94-1.109v-1.094c0-.55.398-1.02.94-1.11l.894-.149c.424-.07.765-.383.93-.78.165-.398.143-.854-.107-1.204l-.527-.738a1.125 1.125 0 01.12-1.45l.773-.773a1.125 1.125 0 011.45-.12l.737.527c.35.25.807.272 1.204.107.397-.165.71-.505.78-.929l.15-.894z M15 12a3 3 0 11-6 0 3 3 0 016 0z' %}
{% set sections = {
    1: {title: 'Enceinte', short: 'Enceinte'}, 2: {title: 'Consignes', short: 'Consignes'}, 3: {title: 'Portes et apports internes', short: 'Apports'},
    4: {title: 'Chauffage', short: 'Chauffage'}, 5: {title: 'Refroidissement', short: 'Froid'}, 6: {title: 'Humidification', short: 'Humidification'},
    7: {title: 'Séchage', short: 'Séchage'}, 8: {title: 'Autres', short: 'Autres'}, 9: {title: 'Régulation', short: 'Régulation'},
    10: {title: 'Résultats', short: 'Résultats', id: 'ec-section-10'},
} %}

{# Champs d'un mode : préfixe des identifiants (ec-s, ec-p) #}
{% macro dimensions(p, c, input) %}
    <div class="space-y-4">
        <div data-show-kind="monobloc" hidden>
            {% import 'calculator/_layout_macros.html.twig' as ui %}
            {{ ui.choiceCards(p ~ '-size-mode', 'Saisie', {volume: {label: 'Volume utile', hint: 'En litres ; dimensions déduites.'}, dims: {label: 'Dimensions', hint: 'Longueur, largeur, hauteur intérieures.'}}, 'volume', {'data-field': 'sizeMode', 'data-action': 'change->' ~ c ~ '#changeSize'}) }}
        </div>
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            {% import 'calculator/_macros.html.twig' as calc %}
            <div data-size="volume" hidden>{{ calc.field(p ~ '-volume', 'Volume utile', 'L', {'data-field': 'volumeLiters', 'data-action': input ~ ' input->' ~ c ~ '#changeSize'}, '1000') }}</div>
            <div data-size="dims">{{ calc.field(p ~ '-length', 'Longueur', 'm', {'data-field': 'length', 'data-action': input ~ ' input->' ~ c ~ '#changeSize'}, '2') }}</div>
            <div data-size="dims">{{ calc.field(p ~ '-width', 'Largeur', 'm', {'data-field': 'width', 'data-action': input ~ ' input->' ~ c ~ '#changeSize'}, '1,5') }}</div>
            <div data-size="dims">{{ calc.field(p ~ '-height', 'Hauteur', 'm', {'data-field': 'height', 'data-action': input ~ ' input->' ~ c ~ '#changeSize'}, '2') }}</div>
        </div>
        <p class="text-sm text-secondary-600 dark:text-secondary-300" aria-live="polite" data-geometry-info></p>
    </div>
{% endmacro %}

{# Section 2, identique dans les deux modes : profil, puis colonnes Température et Humidité #}
{% macro setpoints(p, c, input, change, stabilityT, stabilityRh) %}
    {% import 'calculator/_macros.html.twig' as calc %}
    <div>
        <label for="{{ p }}-profile" class="form-label">Profil de consigne</label>
        <select id="{{ p }}-profile" class="form-input" data-field="profile" data-profile-select data-action="change->{{ c }}#applyProfile"></select>
        <p class="mt-2 text-sm text-secondary-600 dark:text-secondary-300" data-profile-hint></p>
    </div>
    <div class="grid gap-6 md:grid-cols-2">
        <fieldset class="space-y-4 rounded-xl border border-secondary-200 p-4 dark:border-secondary-700">
            <legend class="px-1 text-sm font-semibold text-secondary-900 dark:text-white">Température</legend>
            {{ calc.field(p ~ '-tset', 'Consigne', '°C', {'data-field': 'tSet', 'data-action': input ~ ' change->' ~ c ~ '#changeTemperature'}, '25') }}
            {{ calc.select(p ~ '-stab-t', 'Stabilité', stabilityT, {'data-field': 'stabilityT', 'data-action': 'change->' ~ c ~ '#changeStability'}, '2') }}
            {{ calc.field(p ~ '-tstart', 'Départ (vide : local)', '°C', {'data-field': 'tStart', 'data-action': input}) }}
            {{ calc.field(p ~ '-ramp', 'Mise en régime', 'min', {'data-field': 'rampMinutes', 'data-action': input}, '60') }}
        </fieldset>
        <fieldset class="space-y-4 rounded-xl border border-secondary-200 p-4 dark:border-secondary-700">
            <legend class="px-1 text-sm font-semibold text-secondary-900 dark:text-white">Humidité</legend>
            {{ calc.field(p ~ '-rhset', 'Consigne (vide : non régulée)', '%', {'data-field': 'rhSet', 'data-action': input ~ ' change->' ~ c ~ '#markCustom'}, '60') }}
            {{ calc.select(p ~ '-stab-rh', 'Stabilité', stabilityRh, {'data-field': 'stabilityRh', 'data-action': change}, '5') }}
            {{ calc.field(p ~ '-rhstart', 'Départ (vide : local)', '%', {'data-field': 'rhStart', 'data-action': input}) }}
            {{ calc.field(p ~ '-humid-minutes', 'Mise en régime', 'min', {'data-field': 'humidMinutes', 'data-action': input}, '30') }}
        </fieldset>
    </div>
    <div class="space-y-2" aria-live="polite" data-section-alerts="2"></div>
{% endmacro %}

{# Résultats de la régulation (section 9, les deux modes), remplis par le contrôleur #}
{% macro pidResults() %}
    <div class="space-y-4" aria-live="polite" data-pid-result>
        <p class="text-sm text-secondary-700 dark:text-secondary-300" data-pid-model></p>
        <table class="w-full table-fixed text-sm">
            <caption class="sr-only">Réglages de départ par fonction</caption>
            <thead>
                <tr class="border-b border-secondary-200 text-left text-secondary-700 dark:border-secondary-700 dark:text-secondary-200">
                    <th scope="col" class="w-1/3 py-2 pr-2 sm:w-1/4">Fonction</th>
                    <th scope="col" class="py-2 pr-2 text-right">Xp</th>
                    <th scope="col" class="py-2 pr-2 text-right">Ti</th>
                    <th scope="col" class="hidden py-2 pr-2 text-right sm:table-cell">Td</th>
                    <th scope="col" class="py-2 text-right"><abbr title="Puissance minimale à fournir (en % de la puissance installée) / plage minimale de l'actionneur (TOR : tout ou rien)" class="no-underline">Mini / plage</abbr></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-secondary-100 break-words dark:divide-secondary-700/60" data-pid-loops></tbody>
        </table>
        <div class="space-y-2" data-section-alerts="9"></div>
        <p class="rounded-lg border border-primary-200 bg-primary-50 px-3 py-2 text-sm text-primary-900 dark:border-primary-800 dark:bg-primary-950/50 dark:text-primary-100"><strong class="font-semibold">Information :</strong> réglages de départ indicatifs, issus d'un modèle simplifié (l'air réagit plus vite que les masses). Terminer la mise au point par un autoréglage du régulateur et des essais.</p>
        <div>
            <h3 class="mb-2 text-sm font-semibold tracking-wide text-secondary-500 uppercase dark:text-secondary-400">Architecture conseillée selon la stabilité</h3>
            <table class="w-full table-fixed text-sm">
                <thead>
                    <tr class="border-b border-secondary-200 text-left text-secondary-700 dark:border-secondary-700 dark:text-secondary-200">
                        <th scope="col" class="w-1/3 py-2 pr-2">Classe</th>
                        <th scope="col" class="py-2">Architecture (à vérifier)</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-secondary-100 dark:divide-secondary-700/60">
                    {% for key, row in {
                        '0.5': {cls: '± 0,5 K / ± 1 % HR', text: 'Sorties continues ou relais statiques à cycle court (≤ 1 s) ; PID chaud / froid en « split range » avec zone morte réglable ; sonde PT100 classe A ; actionneurs modulants.'},
                        '1': {cls: '± 1 K / ± 2 à ± 3 % HR', text: 'PID modulant, cycle court.'},
                        '2': {cls: '± 2 à ± 3 K / ± 5 à ± 10 % HR', text: 'PID à cycle plus long ; tout ou rien acceptable pour certains étages.'},
                    } %}
                        <tr data-architecture="{{ key }}" class="data-current:bg-primary-50 dark:data-current:bg-primary-500/10">
                            <th scope="row" class="py-2 pr-2 text-left align-top font-medium text-secondary-800 dark:text-secondary-200">{{ row.cls }}</th>
                            <td class="py-2 align-top text-secondary-700 dark:text-secondary-300">{{ row.text }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            <p class="mt-2 text-sm text-secondary-600 dark:text-secondary-300">Humidité : réguler sur le point de rosée ou l'humidité absolue quand la température varie (couplage température / humidité). La stabilité (dans le temps, en un point) n'est pas l'homogénéité (dans l'espace) : la caractérisation se fait selon le FD X 15-140.</p>
        </div>
    </div>
{% endmacro %}

{% set pidFormulas %}
    <p class="inline-block rounded-lg bg-secondary-100 px-3 py-1 font-mono text-xs text-secondary-800 dark:bg-secondary-900 dark:text-secondary-200">K_u = P / (100 × UA) · τ = C / UA · θ = V / débit de brassage + sonde · Kc = τ / [K_u × (τc + θ)] · Ti = min(τ, 4 × (τc + θ)) · Xp = 100 / Kc</p>
    <p>Modèle premier ordre + temps mort, réglage SIMC (Skogestad) ; procédé quasi intégrateur quand τ ≫ θ. τc = θ par défaut (curseur de nerveux à robuste). PI par défaut ; option PID : Td = θ / 2 (limite de la méthode pour τ ≫ θ, à vérifier par essai). Humidité : M = ρ × V (+ matériaux hygroscopiques), échanges ṁ = fuites + infiltration + air neuf, τ = M / ṁ, K_u = débit maximal / (100 × ṁ) × HR / w.</p>
    <p>Plage de modulation : puissance minimale à fournir (chauffe : besoin le plus faible des deux saisons ; froid : charge la plus faible, apports intermittents absents) comparée à la puissance installée et à la plage de l'actionneur ; au-delà de 3 fois le maintien, découpage en étages conseillé. Colonne « Mini / plage » : puissance minimale à fournir, en % de la puissance installée, puis plage minimale de l'actionneur (TOR : tout ou rien). Valeurs par défaut : brassage 60 vol/h (modulaire) ou 150 vol/h (monobloc), sondes 20 s et 30 s, étendue −50 à +100 °C.</p>
    <p data-pid-detail></p>
{% endset %}

{% set setpointFormulas %}
    <p>Le profil remplit les consignes, qui restent modifiables ; ses tolérances et sa source sont indiquées sous la liste (à vérifier dans l'admin).</p>
    <p>La classe de stabilité conseille le mode de régulation (± 0,5 et ± 1 K : modulation ; ± 2 et ± 3 K : tout ou rien acceptable) et figure dans les hypothèses ; elle ne majore pas les puissances.</p>
    <p>Mise en régime : durées souhaitées (60 min en température, 30 min en humidité) ; l'outil calcule la puissance nécessaire, ou la durée si une puissance est installée (sections 4 et 5). Énergie = Σ(m × cp) × ΔT ; P = (énergie / durée + pertes moyennes) × (1 + marge). Humidité : eau = ρ × V × (w_consigne − w_départ).</p>
    <p>L'outil dimensionne les puissances ; la stabilité (dans le temps, en un point) et l'homogénéité (dans l'espace) se vérifient par caractérisation (FD X 15-140, IEC 60068-3-5 et 3-6).</p>
{% endset %}

<div data-controller="{{ c }} calculator--layout" class="max-lg:pb-28"
     data-{{ c }}-profiles-value="{{ (climatic_profiles ?? [])|map(p => p.toCalculatorArray())|json_encode }}"
     data-{{ c }}-refrigerants-value="{{ (refrigerants ?? [])|map(r => r.toCalculatorArray())|json_encode }}"
     data-{{ c }}-rules-value="{{ (fgas_rules ?? [])|map(r => r.toCalculatorArray())|json_encode }}"
     data-{{ c }}-panels-value="{{ (panel_models ?? [])|map(p => p.toCalculatorArray())|json_encode }}"
     data-{{ c }}-today-value="{{ 'now'|date('Y-m-d') }}">
    <div class="flex flex-wrap items-center gap-4">
        <div class="inline-flex rounded-xl border border-secondary-200 p-1 dark:border-secondary-700" role="group" aria-label="Mode de calcul">
            <button type="button" class="rounded-lg px-4 py-2 text-sm font-semibold aria-pressed:bg-primary-700 aria-pressed:text-white" aria-pressed="true" {{ t }}="modeButton" data-mode="simple" data-action="{{ c }}#setMode calculator--layout#refresh">Simple</button>
            <button type="button" class="rounded-lg px-4 py-2 text-sm font-semibold aria-pressed:bg-primary-700 aria-pressed:text-white" aria-pressed="false" {{ t }}="modeButton" data-mode="pro" data-action="{{ c }}#setMode calculator--layout#refresh">Pro</button>
        </div>
        <p class="max-w-2xl text-sm text-secondary-600 dark:text-secondary-300">Simple : l'essentiel, le reste en hypothèses affichées. Pro : toutes les valeurs.</p>
    </div>

    {{ ui.navPills(sections, 'Sections de l\'outil', 'ec-s') }}

    <div class="mt-6 lg:grid lg:grid-cols-[minmax(0,1fr)_17rem] lg:items-start lg:gap-8">
        <div class="min-w-0 space-y-6">
            {# --- Mode simple --- #}
            <div class="space-y-6" {{ t }}="form" data-mode="simple">
                {% set content %}
                    {{ ui.choiceCards('ec-s-kind', 'Type d\'enceinte', kinds, 'modular', {'data-field': 'kind', 'data-action': 'change->' ~ c ~ '#changeKind'}) }}
                    {{ _self.dimensions('ec-s', c, input) }}
                    <div data-show-kind="modular_outdoor" hidden class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
                        {{ calc.select('ec-s-sun', 'Ensoleillement direct du module', yesNo, {'data-field': 'sun', 'data-action': change}) }}
                        {{ calc.select('ec-s-frost', 'Module chauffé hors gel', yesNo, {'data-field': 'frostProtected', 'data-action': 'change->' ~ c ~ '#changeFrost'}, 'yes') }}
                        <div data-show-frost="no" hidden>{{ calc.field('ec-s-outdoor-min', 'Extérieur, minimum', '°C', {'data-field': 'outdoorMinT', 'data-action': input}, '-5') }}</div>
                    </div>
                    <div data-show-kind="monobloc" hidden>{{ ui.callout('info', 'La chaleur du groupe frigorifique intégré est rejetée dans le local, pas dans l\'enceinte.') }}</div>
                {% endset %}
                {% set formulas %}
                    <p>Panneaux PUR 80 mm : U = 1 / (0,17 + 0,08/0,023) = 0,274 W/(m²·K), sur les 6 faces ; fuites 0,5 % du volume par heure ; peau intérieure inox 1 mm (7,9 kg/m², cp 0,5).</p>
                    <p>Monobloc : ventilation 60 W/m³, étagères 15 kg, structure 25 kg, éclairage 20 W ; porte sur toute la face avant ; volume saisi : largeur L = V^(1/3), profondeur 0,8 L, hauteur 1,25 L.</p>
                    <p>Modulaire : ventilation 35 W/m³, étagères 30 kg, structure et batteries 40 kg, éclairage 40 W ; porte de 0,8 × 2 m. Local : 30 °C / 60 % HR en été, 18 °C / 30 % HR en hiver.</p>
                    <p>Modulaire extérieure : le local est l'intérieur du module, 35 °C / 45 % HR en été (40 °C au soleil) ; en hiver, module chauffé hors gel (5 °C / 70 % HR), ou non chauffé : température extérieure minimale (−5 °C par défaut, 90 % HR).</p>
                {% endset %}
                {{ ui.section('ec-s-section-1', 1, 'Enceinte', icons[1], content, formulas) }}

                {{ ui.section('ec-s-section-2', 2, 'Consignes', icons[2], _self.setpoints('ec-s', c, input, change, stabilityT, stabilityRh), setpointFormulas) }}

                <div class="grid gap-6 md:grid-cols-2">
                    {% set formulas %}
                        <p>Une porte (0,8 × 2 m, ou la face avant d'un monobloc ; U = 0,55, cadre compris), 5 ouvertures de 20 s par jour ; infiltrations ASHRAE (D_f = 0,8) ; cordon de cadre 40 W/m sous +5 °C (70 % réintroduits).</p>
                        <p>Ventilation 100 % dans l'enceinte, 24 h/24 ; éclairage 2 h/j ; câbles et instrumentation 10 W, 24 h/24 ; aucun échantillon ni personne. Dimensionnement : tous les apports présents en même temps ; consommation : selon leur durée.</p>
