{% set input = 'input->' ~ c ~ '#calculate' %}
{% set change = 'change->' ~ c ~ '#calculate' %}
{% set yesNo = {no: 'Non', yes: 'Oui'} %}
{% set kinds = {
    monobloc: {label: 'Monobloc', hint: 'Armoire ou enceinte de laboratoire, 150 à 3 000 litres. Ventilation ≈ 60 W/m³.'},
    modular: {label: 'Modulaire', hint: 'Chambre accessible en panneaux sandwich, montée dans un bâtiment. Ventilation ≈ 35 W/m³.'},
    modular_outdoor: {label: 'Modulaire extérieure', hint: 'Chambre en panneaux sandwich dans un module extérieur (bungalow, module préfabriqué).'},
} %}
{% set sizeModes = {volume: {label: 'Volume utile', hint: 'En litres ; dimensions déduites.'}, dims: {label: 'Dimensions', hint: 'Longueur, largeur, hauteur intérieures.'}} %}
{% set stabilityT = {'0.5': '± 0,5 K', '1': '± 1 K', '2': '± 2 K', '3': '± 3 K'} %}
{% set stabilityRh = {'1': '± 1 % HR', '2': '± 2 % HR', '3': '± 3 % HR', '5': '± 5 % HR', '10': '± 10 % HR'} %}
{% set protections = {none: 'Aucune', strips: 'Rideau à lanières', air_curtain: 'Rideau d\'air', airlock: 'Sas'} %}
{% set heatings = {electric: 'Électrique', hot_water: 'Eau chaude', steam: 'Vapeur', other: 'Autre (rendement saisi)'} %}
{% set coolings = {dx: 'Détente directe', chilled_water: 'Eau glacée', other: 'Autre (COP saisi)'} %}
{% set humidifiers = {steam_electric: 'Vapeur électrique', steam_network: 'Vapeur réseau', adiabatic: 'Pulvérisation ou ultrasons', other: 'Autre (rendement saisi)'} %}
{% set dryings = {dx_coil: 'Batterie froide (détente directe)', chilled_water_coil: 'Batterie à eau glacée', desiccant: 'Dessiccateur (rotor)', other: 'Autre (COP saisi)'} %}
{% set regulations = {modulating: 'Modulation (variateur, by-pass)', on_off: 'Tout ou rien', permanent_reheat: 'Froid permanent + réchauffage'} %}
{% set installations = {self_contained: 'Groupe autonome (monobloc)', split: 'Split (groupe à distance)', centralised: 'Centrale multipostes'} %}
{% set thicknesses = {60: '60 mm', 80: '80 mm', 100: '100 mm', 120: '120 mm', 150: '150 mm', 180: '180 mm', 200: '200 mm'} %}
{% set generic = {PUR: 'PUR (λ 0,023)', PIR: 'PIR (λ 0,022)', XPS: 'XPS (λ 0,034)', EPS: 'EPS (λ 0,036)', rockwool: 'Laine de roche (λ 0,040)'} %}
