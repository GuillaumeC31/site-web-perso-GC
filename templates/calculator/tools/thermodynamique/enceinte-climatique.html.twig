                        <fieldset class="space-y-3">
                            <legend class="text-sm font-semibold text-secondary-900 dark:text-white">Hiver</legend>
                            {{ calc.field('ec-p-fresh-winter-t', 'Température', '°C', {'data-field': 'winterFreshT', 'data-action': input}, '-5') }}
                            {{ calc.field('ec-p-fresh-winter-rh', 'Humidité', '%', {'data-field': 'winterFreshRh', 'data-action': input}, '90') }}
                        </fieldset>
                    {% endset %}
                    {{ ui.group('Renouvellement d\'air', fields, 'sm:grid-cols-3') }}
                    {% set fields %}
                        {{ calc.field('ec-p-run', 'Fonctionnement', 'h/j', {'data-field': 'runHours', 'data-action': input}, '24') }}
                        {{ calc.field('ec-p-margin', 'Marge de sécurité', '%', {'data-field': 'margin', 'data-action': input}, '10') }}
                    {% endset %}
                    {{ ui.group('Fonctionnement', fields, 'sm:grid-cols-3') }}
                {% endset %}
                {% set formulas %}
                    {{ ui.formula('Air neuf : Q = ṁ × (1,006 + 1,86 × w_ext) × ΔT ; eau = ṁ × (w_ext − w_consigne)') }}
                    <p>Fonctionnement sous 24 h/j : froid de maintien × 24 / heures. La marge s'applique aux puissances de maintien et de mise en régime.</p>
                {% endset %}
                {{ ui.section('ec-p-section-8', 8, 'Autres', icons[8], content, formulas) }}

                {% set content %}
                    {% set fields %}
                        {{ calc.select('ec-p-act-heat', 'Chauffe', {ssr: 'Relais statique', phase: 'Gradateur', contactor: 'Contacteur'}, {'data-field': 'actHeat', 'data-action': change}) }}
                        {{ calc.select('ec-p-act-cold', 'Froid', {vsd: 'Compresseur à variateur', hot_gas: 'By-pass de gaz chaud', eev: 'Détendeur électronique', valve: 'Vanne d\'eau glacée 3 voies', on_off: 'Tout ou rien'}, {'data-field': 'actCold', 'data-action': change}) }}
                        <div data-show-for="actCold:vsd">{{ calc.field('ec-p-vsd-min', 'Variateur : plage minimale', '%', {'data-field': 'coldMinPct', 'data-action': input}, '30') }}</div>
                        {{ calc.select('ec-p-act-humid', 'Humidification', {modulating_steam: 'Vapeur modulante', on_off: 'Tout ou rien'}, {'data-field': 'actHumid', 'data-action': change}) }}
                        {{ calc.select('ec-p-act-dry', 'Séchage', {valve: 'Vanne de batterie', desiccant: 'Dessiccateur modulant'}, {'data-field': 'actDry', 'data-action': change}) }}
                        {{ calc.field('ec-p-staging', 'Étages au-delà de (× maintien)', '×', {'data-field': 'stagingRatio', 'data-action': input}, '3') }}
                    {% endset %}
                    {{ ui.group('Actionneurs', fields) }}
                    {% set fields %}
                        {{ calc.field('ec-p-air-changes', 'Brassage', 'vol/h', {'data-field': 'airChanges', 'data-action': input}, '60') }}
                        {{ calc.field('ec-p-sensor-t', 'Sonde de température', 's', {'data-field': 'sensorT', 'data-action': input}, '20') }}
                        {{ calc.field('ec-p-sensor-rh', 'Sonde d\'humidité', 's', {'data-field': 'sensorRh', 'data-action': input}, '30') }}
                        {{ calc.field('ec-p-span', 'Étendue de mesure', 'K', {'data-field': 'spanT', 'data-action': input}, '150') }}
                        {{ calc.field('ec-p-hygro-mass', 'Matériaux hygroscopiques', 'kg', {'data-field': 'hygroMassKg', 'data-action': input}, '0') }}
                        {{ calc.field('ec-p-hygro-cap', 'Capacité d\'absorption', 'g/(kg·%HR)', {'data-field': 'hygroCapacity', 'data-action': input}, '0') }}
                    {% endset %}
                    {{ ui.group('Modèle', fields) }}
                    {% set fields %}
                        <div class="sm:col-span-2">
                            <label for="ec-p-tau" class="form-label">Réponse de la boucle : τc = <output data-tau-output>1</output> × θ</label>
                            <input type="range" id="ec-p-tau" min="0.5" max="3" step="0.5" value="1" class="w-full accent-primary-700 dark:accent-primary-300" data-field="tauFactor" data-action="{{ input }}" aria-describedby="ec-p-tau-hint">
                            <p id="ec-p-tau-hint" class="mt-1 flex justify-between text-xs text-secondary-600 dark:text-secondary-300"><span>Nerveux</span><span>Robuste</span></p>
                        </div>
                        {{ calc.select('ec-p-derivative', 'Action dérivée', {no: 'PI (Td = 0)', yes: 'PID'}, {'data-field': 'derivative', 'data-action': change}) }}
                    {% endset %}
                    {{ ui.group('Réglage', fields) }}
                    {{ _self.pidResults() }}
                {% endset %}
                {{ ui.section('ec-p-section-9', 9, 'Régulation', iconRegulation, content, pidFormulas) }}
            </div>

            {# --- 10. Résultats (les deux modes) --- #}
            {% set content %}
                <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
                    {% for item in [
                        {id: 'ec-cold', label: 'Refroidissement', target: 'cold'}, {id: 'ec-heat', label: 'Chauffe', target: 'heat'},
                        {id: 'ec-dry', label: 'Séchage', target: 'drying'}, {id: 'ec-humid', label: 'Humidification', target: 'humid'},
                    ] %}
                        <div>
                            {{ calc.result(item.id, item.label ~ ' à installer', 'W', {(t): item.target}) }}
                            <p class="mt-1 text-xs text-secondary-600 dark:text-secondary-300" {{ t }}="{{ item.target }}Detail"></p>
                        </div>
                    {% endfor %}
                </div>
                {{ calc.message({(t): 'message'}) }}
                <p class="text-sm text-secondary-600 dark:text-secondary-300" aria-live="polite" {{ t }}="summary"></p>
                <div>
                    <h3 class="mb-3 text-sm font-semibold tracking-wide text-secondary-500 uppercase dark:text-secondary-400">Été et hiver</h3>
                    <table class="w-full table-fixed text-sm">
                        <caption class="sr-only">Résultats du cas été et du cas hiver</caption>
                        <thead>
                            <tr class="border-b border-secondary-200 text-left text-secondary-700 dark:border-secondary-700 dark:text-secondary-200">
                                <th scope="col" class="w-2/5 py-2 pr-4">Grandeur</th>
                                <th scope="col" class="py-2 pr-2 text-right" {{ t }}="summerHeader">Été</th>
                                <th scope="col" class="py-2 text-right" {{ t }}="winterHeader">Hiver</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-secondary-100 break-words dark:divide-secondary-700/60" {{ t }}="seasons"></tbody>
                    </table>
                </div>
                <details class="group rounded-xl border border-secondary-200 dark:border-secondary-700">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-2 rounded-xl px-4 py-3 text-sm font-semibold text-secondary-800 hover:bg-secondary-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700 dark:text-secondary-200 dark:hover:bg-secondary-800/60 [&::-webkit-details-marker]:hidden">
                        Détail poste par poste (formules et calcul chiffré)
                        <svg class="size-4 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 011.06 0L10 11.94l3.72-3.72a.75.75 0 111.06 1.06l-4.25 4.25a.75.75 0 01-1.06 0L5.22 9.28a.75.75 0 010-1.06z" clip-rule="evenodd"/></svg>
                    </summary>
                    <div class="border-t border-secondary-200 px-4 py-3 dark:border-secondary-700">
                        <table class="w-full table-fixed text-sm">
                            <thead>
                                <tr class="border-b border-secondary-200 text-left text-secondary-700 dark:border-secondary-700 dark:text-secondary-200">
                                    <th scope="col" class="w-1/2 py-2 pr-4 sm:w-3/5">Poste, formule et hypothèses</th>
                                    <th scope="col" class="py-2 pr-2 text-right">Été</th>
                                    <th scope="col" class="py-2 text-right">Hiver</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-secondary-100 break-words dark:divide-secondary-700/60" {{ t }}="breakdown"></tbody>
                        </table>
                        <p class="mt-3 text-sm text-secondary-600 dark:text-secondary-300">Puissances sensibles en W (+ : apport à l'enceinte, − : perte), apports internes tous présents (dimensionnement). Valeurs par défaut indicatives, à vérifier pour un dimensionnement réel.</p>
                    </div>
                </details>
                <div>
                    <h3 class="mb-3 text-sm font-semibold tracking-wide text-secondary-500 uppercase dark:text-secondary-400">Fluide et réglementation</h3>
                    <div class="space-y-2 text-sm text-secondary-700 dark:text-secondary-300" aria-live="polite" {{ t }}="fluidReport"></div>
                </div>
            {% endset %}
            {{ ui.section('ec-section-10', 10, 'Résultats', icons[10], content) }}
        </div>

        {# --- Colonne collante (ordinateur) ou barre en bas (mobile) : navigation et puissances à installer --- #}
        <aside class="lg:sticky lg:top-[calc(var(--header-offset,0px)+1.5rem)] lg:space-y-4" aria-label="Navigation et résumé">
            {{ ui.navList(sections, 'Sections de l\'outil', 'ec-s') }}
            <div role="region" aria-label="Puissances à installer" class="fixed inset-x-0 bottom-0 z-30 border-t border-secondary-200 bg-white/95 pb-[env(safe-area-inset-bottom)] shadow-lg backdrop-blur lg:static lg:rounded-2xl lg:border lg:bg-white lg:p-4 lg:pb-4 lg:shadow-none dark:border-secondary-700 dark:bg-secondary-900/95 lg:dark:bg-secondary-800/60">
                <div class="px-4 pt-2 lg:p-0">
                    <div class="flex items-center justify-between gap-2">
                        <p class="text-sm font-bold text-secondary-900 dark:text-white">Puissances à installer</p>
                        <button type="button" class="inline-flex items-center gap-1 rounded-lg px-2 py-1 text-sm font-semibold text-primary-700 hover:bg-primary-50 focus-visible:outline-2 focus-visible:outline-primary-700 lg:hidden dark:text-primary-300 dark:hover:bg-primary-500/10"
                                aria-expanded="false" aria-controls="ec-summary-panel" data-calculator--layout-target="barToggle" data-action="calculator--layout#toggleBar">
                            Alertes <span class="rounded-full bg-secondary-200 px-1.5 text-xs text-secondary-800 data-alerts:bg-amber-100 data-alerts:text-amber-900 dark:bg-secondary-700 dark:text-secondary-100 dark:data-alerts:bg-amber-900 dark:data-alerts:text-amber-100" {{ t }}="alertCount">0</span>
                        </button>
                    </div>
                    <dl class="mt-1 grid grid-cols-4 gap-2 pb-2 lg:mt-3 lg:grid-cols-1 lg:pb-0">
                        {{ ui.summaryItem('Refroidissement', 'Froid', t ~ '=summaryCold', t ~ '=summaryColdDetail') }}
                        {{ ui.summaryItem('Chauffe', 'Chauffe', t ~ '=summaryHeat', t ~ '=summaryHeatDetail') }}
                        {{ ui.summaryItem('Séchage', 'Séchage', t ~ '=summaryDrying', t ~ '=summaryDryingDetail') }}
                        {{ ui.summaryItem('Humidification', 'Humid.', t ~ '=summaryHumid', t ~ '=summaryHumidDetail') }}
                    </dl>
                </div>
                <div id="ec-summary-panel" class="max-h-[50vh] space-y-2 overflow-y-auto px-4 pb-3 max-lg:hidden max-lg:data-open:block lg:mt-3 lg:max-h-none lg:p-0" data-calculator--layout-target="barPanel" {{ t }}="summaryAlerts"></div>
            </div>
        </aside>
    </div>

    {# --- Modèles des éléments des listes (mode pro) ; __ID__ est remplacé par un numéro unique --- #}
    <template {{ t }}="doorTemplate">
        <fieldset class="rounded-xl border border-secondary-200 p-4 dark:border-secondary-700" data-item>
            <legend class="px-1 text-sm font-bold text-secondary-900 dark:text-white" data-item-title>Porte</legend>
            <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
                {{ calc.field('ec-door-__ID__-width', 'Largeur', 'm', {'data-item-field': 'width', 'data-action': input}, '0,8') }}
                {{ calc.field('ec-door-__ID__-height', 'Hauteur', 'm', {'data-item-field': 'height', 'data-action': input}, '2') }}
                {{ calc.field('ec-door-__ID__-u', 'U', 'W/(m²·K)', {'data-item-field': 'u', 'data-action': input}, '0,55') }}
                {{ calc.select('ec-door-__ID__-leaves', 'Vantaux', {1: '1 vantail', 2: '2 vantaux'}, {'data-item-field': 'leaves', 'data-action': change}) }}
                {{ calc.select('ec-door-__ID__-protection', 'Protection', protections, {'data-item-field': 'protection', 'data-action': 'change->' ~ c ~ '#changeProtection'}) }}
                {{ calc.field('ec-door-__ID__-efficiency', 'Efficacité E', '%', {'data-item-field': 'efficiency', 'data-action': input}, '0') }}
                {{ calc.field('ec-door-__ID__-openings', 'Ouvertures', '/j', {'data-item-field': 'openingsPerDay', 'data-action': input}, '5') }}
                {{ calc.field('ec-door-__ID__-seconds', 'Durée', 's', {'data-item-field': 'openSeconds', 'data-action': input}, '20') }}
                {{ calc.field('ec-door-__ID__-heater', 'Cordon de cadre', 'W/m', {'data-item-field': 'heaterWPerM', 'data-action': input}, '0') }}
                <div class="flex items-end justify-end sm:col-span-1 xl:col-span-3">{{ ui.removeButton('Supprimer cette porte', 'Supprimer cette porte ?', c) }}</div>
            </div>
        </fieldset>
    </template>

    <template {{ t }}="glazingTemplate">
        <fieldset class="rounded-xl border border-secondary-200 p-4 dark:border-secondary-700" data-item>
            <legend class="px-1 text-sm font-bold text-secondary-900 dark:text-white" data-item-title>Vitrage</legend>
            <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
                {{ calc.field('ec-glazing-__ID__-area', 'Surface', 'm²', {'data-item-field': 'area', 'data-action': input}, '0,5') }}
                {{ calc.select('ec-glazing-__ID__-type', 'Type', {double: 'Double vitrage', triple: 'Triple vitrage'}, {'data-item-field': 'glazingType', 'data-action': 'change->' ~ c ~ '#changeGlazingType'}) }}
                {{ calc.field('ec-glazing-__ID__-u', 'U', 'W/(m²·K)', {'data-item-field': 'u', 'data-action': input}, '2,8') }}
                {{ calc.select('ec-glazing-__ID__-heated', 'Chauffé', yesNo, {'data-item-field': 'heated', 'data-action': change}) }}
                {{ calc.field('ec-glazing-__ID__-heater', 'Chauffage', 'W', {'data-item-field': 'heaterW', 'data-action': input}, '0') }}
                <div class="flex items-end justify-end sm:col-span-1 xl:col-span-3">{{ ui.removeButton('Supprimer ce vitrage', 'Supprimer ce vitrage ?', c) }}</div>
            </div>
        </fieldset>
    </template>

    <template {{ t }}="manualTemplate">
        <fieldset class="rounded-xl border border-secondary-200 p-4 dark:border-secondary-700" data-item>
            <legend class="px-1 text-sm font-bold text-secondary-900 dark:text-white" data-item-title>Apport</legend>
            <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
                <div class="sm:col-span-2">
                    <label for="ec-manual-__ID__-label" class="form-label">Libellé</label>
                    <input type="text" id="ec-manual-__ID__-label" class="form-input" autocomplete="off" maxlength="80" data-item-field="label" data-item-text data-action="{{ input }}" placeholder="Pompe, agitateur…">
                </div>
                {{ calc.field('ec-manual-__ID__-watts', 'Puissance', 'W', {'data-item-field': 'watts', 'data-action': input}, '0') }}
                {{ calc.field('ec-manual-__ID__-hours', 'Durée (24 : permanent)', 'h/j', {'data-item-field': 'hours', 'data-action': input}, '24') }}
                {{ calc.field('ec-manual-__ID__-fraction', 'Fraction dans l\'enceinte', '0 à 1', {'data-item-field': 'fraction', 'data-action': input}, '1') }}
                {{ calc.field('ec-manual-__ID__-water', 'Part latente', 'g/h', {'data-item-field': 'waterGPerH', 'data-action': input}, '0') }}
                <div class="flex items-end justify-end sm:col-span-2">{{ ui.removeButton('Supprimer cet apport', 'Supprimer cet apport ?', c) }}</div>
            </div>
        </fieldset>
    </template>
</div>
