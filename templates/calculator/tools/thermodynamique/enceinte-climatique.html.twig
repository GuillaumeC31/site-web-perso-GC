                            {{ calc.field('ec-p-lines', 'Liaisons (split)', 'm', {'data-field': 'lineLength', 'data-action': input}, '10') }}
                            {{ calc.select('ec-p-detection', 'Détection des fuites', yesNo, {'data-field': 'detection', 'data-action': change}) }}
