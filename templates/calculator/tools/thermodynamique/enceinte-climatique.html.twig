                            </thead>
                            <tbody class="divide-y divide-secondary-100 dark:divide-secondary-700/60">
                                {% for row in [
                                    {label: 'Peau intérieure (inox)', unit: 'kg/m²', mass: 'skinKgPerM2', cp: 'skinCp', m: '7,9', c: '0,5'},
                                    {label: 'Étagères', unit: 'kg', mass: 'shelvesKg', cp: 'shelvesCp', m: '30', c: '0,5'},
