{#
  Thème des formulaires Symfony aux couleurs du design system.
  Déclaré dans : config/packages/twig.yaml (twig.form_themes).
  Base : thème Tailwind fourni par Symfony (tailwind_2_layout), classes remplacées par
  celles de assets/styles/app.css (.form-label, .form-input, .form-help, .form-error).
#}
{% use 'tailwind_2_layout.html.twig' %}

{%- block form_row -%}
    {%- set row_class = row_class|default('mb-5') -%}
    {{- parent() -}}
{%- endblock form_row -%}

{%- block widget_attributes -%}
    {%- set widget_class = widget_class|default('form-input') -%}
    {{- parent() -}}
{%- endblock widget_attributes -%}

{%- block form_label -%}
    {%- set label_class = label_class|default('form-label') -%}
    {{- parent() -}}
{%- endblock form_label -%}

{%- block form_help -%}
    {%- set help_class = help_class|default('form-help') -%}
    {{- parent() -}}
{%- endblock form_help -%}

{%- block form_errors -%}
    {%- set error_item_class = error_item_class|default('form-error') -%}
    {{- parent() -}}
{%- endblock form_errors -%}

{%- block checkbox_widget -%}
    {%- set widget_class = widget_class|default('mt-0.5 size-4 shrink-0 rounded border-secondary-300 text-primary-700 focus:ring-primary-600 dark:border-secondary-600 dark:bg-secondary-800') -%}
    {{- parent() -}}
{%- endblock checkbox_widget -%}

{# Case à cocher : alignée sur la première ligne du libellé (libellés longs sur plusieurs lignes), espacée du texte #}
{%- block checkbox_row -%}
    {%- set row_attr = row_attr|merge({class: row_attr.class|default(row_class|default('mb-5'))}) -%}
    {%- set widget_attr = {} -%}
    {%- if help -%}
        {%- set widget_attr = {attr: {'aria-describedby': id ~ '_help'}} -%}
    {%- endif -%}
    <div{% with {attr: row_attr} %}{{ block('attributes') }}{% endwith %}>
        {{- form_errors(form) -}}
        <div class="flex items-start gap-3">
            {{- form_widget(form, widget_attr) -}}
            {{- form_label(form, null, {label_attr: {class: 'text-sm leading-5 text-secondary-800 dark:text-secondary-200'}}) -}}
        </div>
        {{- form_help(form, {help_attr: {class: 'form-help ml-7'}}) -}}
    </div>
{%- endblock checkbox_row -%}
